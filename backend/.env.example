# ResumeRadar backend configuration
# Copy this file to `.env` and adjust values as needed.

# Secret used to sign JWT tokens. CHANGE THIS in production.
SECRET_KEY=change-me-to-a-long-random-string

# Token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database file path (relative to backend/)
DATABASE_URL=sqlite:///./data/resumeradar.db

# Local AI via Ollama (see README "Private AI"). Pull the model you name here:
#   ollama pull qwen2.5:1.5b     # fast on CPU (default)
#   ollama pull qwen2.5:3b       # better quality, slower
# Use 127.0.0.1 rather than localhost: some systems resolve localhost to ::1,
# which the Ollama server does not listen on.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
